{
	"name": "talachastats",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:run": "npx tsx src/db/migrate.ts",
		"db:seed": "npx tsx src/db/seed.ts",
		"db:reset": "npx tsx src/db/seed.ts --reset",
		"dev:setup": "pnpm db:migrate:run && pnpm db:seed && pnpm dev",
		"prepare": "husky"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.103.0",
		"@types/pg": "^8.20.0",
		"@vercel/analytics": "^2.0.1",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"lucide-react": "^1.8.0",
		"next": "16.2.3",
		"pdfkit": "^0.18.0",
		"pg": "^8.20.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/pdfkit": "^0.17.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.3",
		"eslint-config-prettier": "^10.1.5",
		"husky": "^9.1.7",
		"jsdom": "^29.1.0",
		"lint-staged": "^15.5.1",
		"prettier": "^3.5.3",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.5"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"overrides": {
			"postcss@<8.5.10": ">=8.5.10"
		}
	}
}
