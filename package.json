{
	"name": "talachastats",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
	"engines": {
		"node": "24.x",
		"pnpm": ">=10 <11"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"db:generate": "drizzle-kit generate",
		"db:migrate:run": "npx tsx src/db/migrate.ts",
		"db:migrate:global-players": "npx tsx src/db/migrate-to-global-players.ts",
		"db:migrate:league-members": "npx tsx src/db/migrate-to-league-members.ts",
		"db:seed": "npx tsx src/db/seed.ts",
		"db:reset": "npx tsx src/db/seed.ts --reset",
		"dev:setup": "pnpm db:migrate:run && pnpm db:seed && pnpm dev",
		"prepare": "husky",
		"audit:strict": "pnpm audit --audit-level=high",
		"db:backup": "db-tools backup --keep 7 --latest",
		"db:sync": "db-tools sync --ext pg_trgm,unaccent --yes"
	},
	"dependencies": {
		"@commitlint/types": "^20.5.0",
		"@fullcalendar/core": "^6.1.20",
		"@fullcalendar/interaction": "^6.1.20",
		"@fullcalendar/react": "^6.1.20",
		"@fullcalendar/timegrid": "^6.1.20",
		"@hookform/resolvers": "^5.4.0",
		"@supabase/supabase-js": "^2.103.0",
		"@tanstack/react-query": "^5.101.1",
		"@tanstack/react-table": "8.21.3",
		"@types/pg": "^8.20.0",
		"@types/qrcode": "^1.5.6",
		"@vercel/analytics": "^2.0.1",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"lucide-react": "^1.8.0",
		"next": "16.2.6",
		"pdfkit": "^0.18.0",
		"pg": "^8.20.0",
		"qrcode": "^1.5.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.80.0",
		"resend": "^6.12.2",
		"sileo": "^0.1.5",
		"zod": "^4.3.6",
		"zustand": "^5.0.13"
	},
	"optionalDependencies": {
		"@jocobi/db-tools": "git+https://github.com/Jocobii/db-tools.git"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24",
		"@types/pdfkit": "^0.17.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.3",
		"eslint-config-prettier": "^10.1.5",
		"husky": "^9.1.7",
		"jsdom": "^29.1.0",
		"lint-staged": "^15.5.1",
		"prettier": "^3.5.3",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.5"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"overrides": {
			"postcss@<8.5.10": ">=8.5.10",
			"exceljs>uuid": "~14.0.0"
		}
	}
}
