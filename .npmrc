# Fuerza el uso exacto de la versión definida en "packageManager".
# pnpm falla con error si la versión no coincide, en lugar de solo advertir.
engine-strict=true

# Seguridad supply-chain: no instalar paquetes publicados hace menos de 24 h.
# Protege contra ataques tipo "package freshness" (compromisos TanStack/Mistral 2025).
# 1440 min = 24 horas.
minimum-release-age=1440
